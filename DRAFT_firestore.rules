rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.token.email == 'tushar5077070@gmail.com');
    }

    // 3. Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    function isValidStory(data) {
      return data.keys().hasAll([
          'storyId',
          'anonymousId',
          'content',
          'seedType',
          'flowerVariant',
          'contentWarning',
          'moderationStatus',
          'warmthCount',
          'messageCount',
          'positionX',
          'positionY',
          'scale',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'storyId',
          'anonymousId',
          'content',
          'seedType',
          'flowerVariant',
          'contentWarning',
          'moderationStatus',
          'warmthCount',
          'messageCount',
          'positionX',
          'positionY',
          'scale',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.storyId) &&
        data.anonymousId is string &&
        data.anonymousId.size() >= 5 &&
        data.anonymousId.size() <= 40 &&
        data.anonymousId.matches('^Anonymous Soul #[0-9]{3,6}$') &&
        data.content is string &&
        data.content.size() >= 5 &&
        data.content.size() <= 2000 &&
        data.seedType is string &&
        data.seedType in ['daisy', 'sunflower', 'lavender'] &&
        data.flowerVariant is string &&
        data.flowerVariant in ['pink-tulip', 'yellow-tulip', 'orange-tulip', 'purple-wildflower', 'daisy', 'sunflower', 'lavender'] &&
        data.contentWarning is string &&
        data.contentWarning.size() >= 0 &&
        data.contentWarning.size() <= 120 &&
        data.moderationStatus is string &&
        data.moderationStatus in ['approved', 'flagged', 'removed'] &&
        data.warmthCount is int &&
        data.warmthCount >= 0 &&
        data.warmthCount <= 1000000 &&
        data.messageCount is int &&
        data.messageCount >= 0 &&
        data.messageCount <= 100000 &&
        (data.positionX is int || data.positionX is float) &&
        data.positionX >= 2 &&
        data.positionX <= 98 &&
        (data.positionY is int || data.positionY is float) &&
        data.positionY >= 5 &&
        data.positionY <= 88 &&
        (data.scale is int || data.scale is float) &&
        data.scale >= 0.5 &&
        data.scale <= 1.4 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReaction(data) {
      return data.keys().hasAll(['reactionId', 'storyId', 'reactionType', 'createdAt']) &&
        data.keys().hasOnly(['reactionId', 'storyId', 'reactionType', 'createdAt']) &&
        isValidId(data.reactionId) &&
        isValidId(data.storyId) &&
        data.reactionType is string &&
        data.reactionType in ['warmth', 'sunlight', 'gentle-rain'] &&
        data.createdAt is timestamp;
    }

    function isValidSupportiveMessage(data) {
      return data.keys().hasAll(['messageId', 'storyId', 'anonymousId', 'content', 'moderationStatus', 'createdAt']) &&
        data.keys().hasOnly(['messageId', 'storyId', 'anonymousId', 'content', 'moderationStatus', 'createdAt']) &&
        isValidId(data.messageId) &&
        isValidId(data.storyId) &&
        data.anonymousId is string &&
        data.anonymousId.size() >= 5 &&
        data.anonymousId.size() <= 40 &&
        data.anonymousId.matches('^Kind Gardener #[0-9]{3,6}$') &&
        data.content is string &&
        data.content.size() >= 2 &&
        data.content.size() <= 500 &&
        data.moderationStatus is string &&
        data.moderationStatus in ['approved', 'flagged', 'removed'] &&
        data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reportId', 'targetType', 'targetId', 'storyId', 'reason', 'details', 'status', 'createdAt']) &&
        data.keys().hasOnly(['reportId', 'targetType', 'targetId', 'storyId', 'reason', 'details', 'status', 'createdAt']) &&
        isValidId(data.reportId) &&
        data.targetType is string &&
        data.targetType in ['story', 'message'] &&
        isValidId(data.targetId) &&
        isValidId(data.storyId) &&
        data.reason is string &&
        data.reason in ['self-harm', 'harassment', 'spam', 'pii', 'other'] &&
        data.details is string &&
        data.details.size() >= 0 &&
        data.details.size() <= 500 &&
        data.status is string &&
        data.status in ['pending', 'reviewed'] &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules: Stories
    match /stories/{storyId} {
      allow get: if isValidId(storyId) && (existing().moderationStatus == 'approved' || isAdmin());
      allow list: if existing().moderationStatus == 'approved' || isAdmin();

      allow create: if isValidId(storyId) &&
        isValidStory(incoming()) &&
        incoming().storyId == storyId &&
        incoming().moderationStatus == 'approved' &&
        incoming().warmthCount == 0 &&
        incoming().messageCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidStory(incoming()) &&
        isValidId(storyId) &&
        (existing().moderationStatus != 'removed' || isAdmin()) &&
        incoming().storyId == existing().storyId &&
        incoming().anonymousId == existing().anonymousId &&
        incoming().content == existing().content &&
        incoming().seedType == existing().seedType &&
        incoming().flowerVariant == existing().flowerVariant &&
        incoming().contentWarning == existing().contentWarning &&
        incoming().positionX == existing().positionX &&
        incoming().positionY == existing().positionY &&
        incoming().scale == existing().scale &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Increment Warmth Count by 1
          (incoming().diff(existing()).affectedKeys().hasOnly(['warmthCount', 'updatedAt']) &&
            incoming().warmthCount == existing().warmthCount + 1 &&
            incoming().messageCount == existing().messageCount &&
            incoming().moderationStatus == existing().moderationStatus &&
            existsAfter(/databases/$(database)/documents/stories/$(storyId))) ||
          // Action 2: Increment Supportive Message Count by 1
          (incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'updatedAt']) &&
            incoming().messageCount == existing().messageCount + 1 &&
            incoming().warmthCount == existing().warmthCount &&
            incoming().moderationStatus == existing().moderationStatus &&
            existsAfter(/databases/$(database)/documents/stories/$(storyId))) ||
          // Action 3: Admin Moderation Override
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['moderationStatus', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(storyId);

      // Subcollection: Reactions
      match /reactions/{reactionId} {
        allow get: if isValidId(storyId) &&
          isValidId(reactionId) &&
          existing().storyId == storyId &&
          exists(/databases/$(database)/documents/stories/$(storyId)) &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.moderationStatus == 'approved';

        allow list: if existing().storyId == storyId &&
          existing().reactionType in ['warmth', 'sunlight', 'gentle-rain'];

        allow create: if isValidId(storyId) &&
          isValidId(reactionId) &&
          isValidReaction(incoming()) &&
          incoming().reactionId == reactionId &&
          incoming().storyId == storyId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/stories/$(storyId)) &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.moderationStatus == 'approved' &&
          getAfter(/databases/$(database)/documents/stories/$(storyId)).data.warmthCount ==
            get(/databases/$(database)/documents/stories/$(storyId)).data.warmthCount + 1;

        allow update, delete: if false;
      }

      // Subcollection: Supportive Messages
      match /messages/{messageId} {
        allow get: if isValidId(storyId) &&
          isValidId(messageId) &&
          existing().storyId == storyId &&
          existing().moderationStatus == 'approved' &&
          exists(/databases/$(database)/documents/stories/$(storyId)) &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.moderationStatus == 'approved';

        allow list: if existing().storyId == storyId &&
          existing().moderationStatus == 'approved';

        allow create: if isValidId(storyId) &&
          isValidId(messageId) &&
          isValidSupportiveMessage(incoming()) &&
          incoming().messageId == messageId &&
          incoming().storyId == storyId &&
          incoming().moderationStatus == 'approved' &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/stories/$(storyId)) &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.moderationStatus == 'approved' &&
          getAfter(/databases/$(database)/documents/stories/$(storyId)).data.messageCount ==
            get(/databases/$(database)/documents/stories/$(storyId)).data.messageCount + 1;

        allow update: if isValidSupportiveMessage(incoming()) &&
          isValidId(storyId) &&
          isValidId(messageId) &&
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['moderationStatus']);

        allow delete: if isAdmin() && isValidId(storyId) && isValidId(messageId);
      }
    }

    // 5. Collection Rules: Moderation Reports
    match /reports/{reportId} {
      allow get: if isAdmin() && isValidId(reportId);
      allow list: if isAdmin() && existing().status in ['pending', 'reviewed'];

      allow create: if isValidId(reportId) &&
        isValidReport(incoming()) &&
        incoming().reportId == reportId &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/stories/$(incoming().storyId));

      allow update, delete: if false;
    }

    // 6. Collection Rules: Admins
    match /admins/{adminId} {
      allow get: if isAdmin() && isValidId(adminId);
      allow list, create, update, delete: if false;
    }
  }
}
