    "SavedMemory": {
      "title": "SavedMemory",
      "description": "User's private saved collection of anonymous community posts, kind replies, or personal diary entries.",
      "type": "object",
      "properties": {
        "memoryId": {
          "type": "string",
          "description": "Unique identifier for the saved memory.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the collector.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sourceType": {
          "type": "string",
          "description": "Origin type of the saved memory.",
          "enum": ["community_story", "supportive_reply", "diary_entry"]
        },
        "sourceId": {
          "type": "string",
          "description": "Referenced story, message, or diary entry ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "anonymousLabel": {
          "type": "string",
          "description": "Preserved anonymous label (never exposes real author identity).",
          "minLength": 1,
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "description": "Optional heading or context title for the memory.",
          "minLength": 0,
          "maxLength": 140
        },
        "excerpt": {
          "type": "string",
          "description": "Text excerpt of the bookmarked story, kind message, or diary entry.",
          "minLength": 1,
          "maxLength": 2000
        },
        "flowerVariant": {
          "type": "string",
          "description": "Flower variant associated with the saved memory, if applicable.",
          "minLength": 0,
          "maxLength": 40
        },
        "folder": {
          "type": "string",
          "description": "User organization collection folder.",
          "enum": ["Quiet Comfort", "Kind Words", "Personal Milestones", "Unsorted"]
        },
        "personalNote": {
          "type": "string",
          "description": "Private personal note attached to the memory.",
          "minLength": 0,
          "maxLength": 300
        },
        "savedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when memory was saved."
        }
      },
      "required": [
        "memoryId",
        "userId",
        "sourceType",
        "sourceId",
        "anonymousLabel",
        "title",
        "excerpt",
        "flowerVariant",
        "folder",
        "personalNote",
        "savedAt"
      ]
    },
    "InnerJournalEntry": {
      "title": "InnerJournalEntry",
      "description": "Private My Inner Garden voice/text journal entry isolated per user with per-entry AI opt-in control and optional AI analysis.",
      "type": "object",
      "properties": {
        "entryId": {
