      "description": "Private voice recording journals strictly isolated to the owning user."
    },
    "/userAccounts/{userId}/memories/{memoryId}": {
      "schema": "SavedMemory",
      "description": "Private bookmarked memories strictly isolated to the owning user."
    },
    "/userAccounts/{userId}/innerJournalEntries/{entryId}": {
      "schema": "InnerJournalEntry",
      "description": "Private My Inner Garden voice and text entries strictly isolated to the owning user."
    },
    "/userAccounts/{userId}/innerReflections/{reflectionId}": {
      "schema": "InnerReflectionMemory",
      "description": "Private weekly and monthly AI reflections strictly isolated to the owning user."
    },
    "/userAccounts/{userId}/innerPrivacyPrefs/{prefId}": {
      "schema": "InnerPrivacyPrefs",
      "description": "Explicit user privacy consent toggles for My Inner Garden audio storage and AI processing."
    },
    "/userAccounts/{userId}/plantedStories/{storyId}": {
      "schema": "PlantedStoryReceipt",
      "description": "Strictly private owner-only ownership receipts allowing authors to remove their own planted stories while keeping public stories completely anonymous."
