{
  "entities": {
    "Story": {
      "title": "Story",
      "description": "An anonymous emotional story planted as a seed in the living meadow.",
      "type": "object",
      "properties": {
        "storyId": {
          "type": "string",
          "description": "Unique identifier for the story document.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "anonymousId": {
          "type": "string",
          "description": "Generated anonymous soul identifier (e.g., Anonymous Soul #1048).",
          "minLength": 5,
          "maxLength": 40,
          "pattern": "^Anonymous Soul #[0-9]{3,6}$"
        },
        "content": {
          "type": "string",
          "description": "The anonymous trauma or emotional experience written by the visitor.",
          "minLength": 5,
          "maxLength": 2000
        },
        "seedType": {
          "type": "string",
          "description": "The chosen seed archetype for the story.",
          "enum": ["daisy", "sunflower", "lavender"]
        },
        "flowerVariant": {
          "type": "string",
          "description": "The visual flower variety rendered in the meadow.",
          "enum": ["pink-tulip", "yellow-tulip", "orange-tulip", "purple-wildflower", "daisy", "sunflower", "lavender"]
        },
        "contentWarning": {
          "type": "string",
          "description": "Optional content warning note (empty string if none).",
          "minLength": 0,
          "maxLength": 120
        },
        "moderationStatus": {
          "type": "string",
          "description": "Moderation visibility status of the story.",
          "enum": ["approved", "flagged", "removed"]
        },
        "warmthCount": {
          "type": "integer",
          "description": "Total supportive warmth reactions sent to this flower."
        },
        "messageCount": {
          "type": "integer",
          "description": "Total supportive kind messages left on this flower."
        },
        "positionX": {
          "type": "number",
          "description": "Horizontal percentage position in the flower meadow (2 to 98)."
        },
        "positionY": {
          "type": "number",
          "description": "Depth percentage position in the flower meadow (5 to 88)."
        },
        "scale": {
          "type": "number",
          "description": "Visual scale multiplier for natural variation (0.5 to 1.4)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the seed was planted."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the flower was last updated."
        }
      },
      "required": [
        "storyId",
        "anonymousId",
        "content",
        "seedType",
        "flowerVariant",
        "contentWarning",
        "moderationStatus",
        "warmthCount",
        "messageCount",
        "positionX",
        "positionY",
        "scale",
        "createdAt",
        "updatedAt"
      ]
    },
    "Reaction": {
      "title": "Reaction",
      "description": "A supportive reaction sent to an anonymous flower.",
      "type": "object",
      "properties": {
        "reactionId": {
          "type": "string",
          "description": "Unique identifier for the reaction document.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storyId": {
          "type": "string",
          "description": "Parent story ID receiving the warmth reaction.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reactionType": {
          "type": "string",
          "description": "Type of supportive warmth sent.",
          "enum": ["warmth", "sunlight", "gentle-rain"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the reaction was created."
        }
      },
      "required": ["reactionId", "storyId", "reactionType", "createdAt"]
    },
    "SupportiveMessage": {
      "title": "SupportiveMessage",
      "description": "An anonymous kind message left for a story author.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "Unique identifier for the message document.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storyId": {
          "type": "string",
          "description": "Parent story ID this message supports.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "anonymousId": {
          "type": "string",
          "description": "Anonymous responder label (e.g., Kind Gardener #402).",
          "minLength": 5,
          "maxLength": 40,
          "pattern": "^Kind Gardener #[0-9]{3,6}$"
        },
        "content": {
          "type": "string",
          "description": "Supportive message content.",
          "minLength": 2,
          "maxLength": 500
        },
        "moderationStatus": {
          "type": "string",
          "description": "Moderation status of the supportive message.",
          "enum": ["approved", "flagged", "removed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the message was created."
        }
      },
      "required": ["messageId", "storyId", "anonymousId", "content", "moderationStatus", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "A content moderation report for harmful or inappropriate submissions.",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "description": "Unique identifier for the report.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetType": {
          "type": "string",
          "description": "Whether a story or message is being reported.",
          "enum": ["story", "message"]
        },
        "targetId": {
          "type": "string",
          "description": "ID of the reported item.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storyId": {
          "type": "string",
          "description": "Associated story ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reason": {
          "type": "string",
          "description": "Reason category for reporting.",
          "enum": ["self-harm", "harassment", "spam", "pii", "other"]
        },
        "details": {
          "type": "string",
          "description": "Optional additional context.",
          "minLength": 0,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Review status of the report.",
          "enum": ["pending", "reviewed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the report was submitted."
        }
      },
      "required": ["reportId", "targetType", "targetId", "storyId", "reason", "details", "status", "createdAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user account and login metadata recorded when a visitor signs in.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID for the user.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Verified account email address.",
          "minLength": 3,
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "description": "Display name from identity provider.",
          "minLength": 0,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "providerId": {
          "type": "string",
          "description": "Authentication provider identifier.",
          "minLength": 1,
          "maxLength": 40
        },
        "role": {
          "type": "string",
          "description": "Account access role.",
          "enum": ["member", "admin"]
        },
        "userAgentSummary": {
          "type": "string",
          "description": "Compact browser/device summary captured at login.",
          "minLength": 0,
          "maxLength": 160
        },
        "loginCount": {
          "type": "integer",
          "description": "Total number of recorded sign-ins."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the most recent sign-in."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account first logged in."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last account update."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "providerId",
        "role",
        "userAgentSummary",
        "loginCount",
        "lastLoginAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "LoginEvent": {
      "title": "LoginEvent",
      "description": "Immutable login audit entry created whenever a user signs in.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "description": "Unique identifier for the login event.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user who logged in.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "description": "Email address used during login.",
          "minLength": 3,
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "description": "Display name at time of login.",
          "minLength": 0,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Profile photo URL at time of login.",
          "minLength": 0,
          "maxLength": 500
        },
        "providerId": {
          "type": "string",
          "description": "Authentication provider identifier.",
          "minLength": 1,
          "maxLength": 40
        },
        "userAgentSummary": {
          "type": "string",
          "description": "Browser/device summary at time of login.",
          "minLength": 0,
          "maxLength": 160
        },
        "loggedInAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the login occurred."
        }
      },
      "required": [
        "eventId",
        "uid",
        "email",
        "displayName",
        "photoURL",
        "providerId",
        "userAgentSummary",
        "loggedInAt"
      ]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Subscription plan record assigned and managed by the admin for a logged-in user.",
      "type": "object",
      "properties": {
        "subscriptionId": {
          "type": "string",
          "description": "Unique identifier for the subscription record.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user in /userAccounts.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "description": "User email snapshot for quick reference.",
          "minLength": 3,
          "maxLength": 120
        },
        "userName": {
          "type": "string",
          "description": "User display name snapshot.",
          "minLength": 0,
          "maxLength": 100
        },
        "planName": {
          "type": "string",
          "description": "Subscription plan tier.",
          "enum": ["free", "seedling", "bloom", "sanctuary"]
        },
        "billingCycle": {
          "type": "string",
          "description": "Billing cadence for the subscription.",
          "enum": ["monthly", "yearly", "lifetime", "custom"]
        },
        "amountPaid": {
          "type": "number",
          "description": "Recorded subscription amount (0 to 100000)."
        },
        "currency": {
          "type": "string",
          "description": "Currency code.",
          "enum": ["INR", "USD", "EUR", "GBP"]
        },
        "status": {
          "type": "string",
          "description": "Lifecycle status of the subscription plan.",
          "enum": ["active", "trialing", "paused", "expired", "cancelled"]
        },
        "notes": {
          "type": "string",
          "description": "Admin notes or payment reference.",
          "minLength": 0,
          "maxLength": 500
        },
        "startedAt": {
          "type": "string",
          "description": "Start date string (YYYY-MM-DD).",
          "minLength": 0,
          "maxLength": 40
        },
        "expiresAt": {
          "type": "string",
          "description": "Expiration date string (YYYY-MM-DD) or empty.",
          "minLength": 0,
          "maxLength": 40
        },
        "recordedByUid": {
          "type": "string",
          "description": "Admin UID who recorded or updated the plan.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recordedByEmail": {
          "type": "string",
          "description": "Admin email who recorded or updated the plan.",
          "minLength": 3,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the subscription record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the subscription record was last updated."
        }
      },
      "required": [
        "subscriptionId",
        "userId",
        "userEmail",
        "userName",
        "planName",
        "billingCycle",
        "amountPaid",
        "currency",
        "status",
        "notes",
        "startedAt",
        "expiresAt",
        "recordedByUid",
        "recordedByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "SecretGardenMembership": {
      "title": "SecretGardenMembership",
      "description": "User-facing The Secret Garden subscription, 30-day no-card free trial, and personal garden customisation state.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID owning this membership document.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planId": {
          "type": "string",
          "description": "Selected Secret Garden plan tier.",
          "enum": ["free", "secret_garden_monthly", "secret_garden_annual"]
        },
        "status": {
          "type": "string",
          "description": "Current membership lifecycle status.",
          "enum": ["free", "trialing", "active", "cancelled", "expired"]
        },
        "hasUsedFreeTrial": {
          "type": "boolean",
          "description": "Prevents resetting the one-time first-month free trial."
        },
        "trialStartedAt": {
          "type": "string",
          "description": "ISO date when trial started.",
          "minLength": 0,
          "maxLength": 40
        },
        "trialEndsAt": {
          "type": "string",
          "description": "ISO date when 30-day free trial ends.",
          "minLength": 0,
          "maxLength": 40
        },
        "billingCycle": {
          "type": "string",
          "description": "Selected billing cycle.",
          "enum": ["none", "monthly", "annual"]
        },
        "priceInr": {
          "type": "integer",
          "description": "Plan price in INR (0, 99, or 799)."
        },
        "startedAt": {
          "type": "string",
          "description": "Membership start date (YYYY-MM-DD).",
          "minLength": 0,
          "maxLength": 40
        },
        "nextBillingAt": {
          "type": "string",
          "description": "Next billing or trial decision date (YYYY-MM-DD).",
          "minLength": 0,
          "maxLength": 40
        },
        "autoRenew": {
          "type": "boolean",
          "description": "Explicit informed-consent renewal preference (always false on trial)."
        },
        "paymentMode": {
          "type": "string",
          "description": "Indicates trial without card, development demo checkout, or admin assignment.",
          "enum": ["none", "trial_no_card", "demo_checkout", "admin_assigned"]
        },
        "gardenTheme": {
          "type": "string",
          "description": "Selected personal garden atmosphere theme.",
          "enum": ["meadow", "twilight", "blossom_mist", "golden_hour"]
        },
        "gardenBackground": {
          "type": "string",
          "description": "Selected sky and horizon backdrop option.",
          "enum": ["classic_sky", "pastel_dawn", "starlit_dusk", "dew_morning"]
        },
        "gardenEffect": {
          "type": "string",
          "description": "Subtle visual ambient particle effect.",
          "enum": ["breeze", "fireflies", "sakura_drift", "sunbeams"]
        },
        "exclusiveFloraPreset": {
          "type": "string",
          "description": "Exclusive visual flora palette accent.",
          "enum": ["classic", "moonlight_iris", "pastel_peony", "golden_lotus"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when membership record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when membership record was updated."
        }
      },
      "required": [
        "userId",
        "planId",
        "status",
        "hasUsedFreeTrial",
        "trialStartedAt",
        "trialEndsAt",
        "billingCycle",
        "priceInr",
        "startedAt",
        "nextBillingAt",
        "autoRenew",
        "paymentMode",
        "gardenTheme",
        "gardenBackground",
        "gardenEffect",
        "exclusiveFloraPreset",
        "createdAt",
        "updatedAt"
      ]
    },
    "DiaryEntry": {
      "title": "DiaryEntry",
      "description": "Strictly private personal diary entry accessible only to the owning user.",
      "type": "object",
      "properties": {
        "entryId": {
          "type": "string",
          "description": "Unique identifier for the diary entry.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the diary owner.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Optional user-supplied diary entry title.",
          "minLength": 0,
          "maxLength": 120
        },
        "content": {
          "type": "string",
          "description": "Private diary reflection text.",
          "minLength": 1,
          "maxLength": 5000
        },
        "moodTag": {
          "type": "string",
          "description": "Optional user-chosen quiet label (not a clinical diagnosis).",
          "minLength": 0,
          "maxLength": 40
        },
        "entryDate": {
          "type": "string",
          "description": "Date string YYYY-MM-DD for chronological timeline filtering.",
          "minLength": 4,
          "maxLength": 40
        },
        "isMemorySaved": {
          "type": "boolean",
          "description": "Whether this diary entry is bookmarked in My Memories."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when entry was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when entry was last edited."
        }
      },
      "required": [
        "entryId",
        "userId",
        "title",
        "content",
        "moodTag",
        "entryDate",
        "isMemorySaved",
        "createdAt",
        "updatedAt"
      ]
    },
    "VoiceJournal": {
      "title": "VoiceJournal",
      "description": "Private audio voice recording journal accessible only to the owning user.",
