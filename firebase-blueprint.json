      "schema": "Report",
      "description": "Collection of moderation reports submitted by visitors."
    },
    "/userAccounts/{userId}": {
      "schema": "UserAccount",
      "description": "Authenticated user account profiles and login summary accessible to the account owner and admin."
    },
    "/loginEvents/{eventId}": {
      "schema": "LoginEvent",
      "description": "Immutable login event history readable by the user (own events) and admin."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Subscription plans recorded and managed by the admin, readable by the user (own plan) and admin."
    },
    "/secretGardenMemberships/{userId}": {
      "schema": "SecretGardenMembership",
      "description": "Per-user The Secret Garden membership, 30-day free trial, and personal garden customisation state."
    },
    "/userAccounts/{userId}/personalDiary/{entryId}": {
      "schema": "DiaryEntry",
      "description": "Private personal diary entries strictly isolated to the owning user."
    },
    "/userAccounts/{userId}/voiceJournals/{voiceId}": {
