rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.token.email == 'tushar5077070@gmail.com');
    }

    function hasSecretGardenAccess(userId) {
      return isOwner(userId) || isAdmin();
    }

    // 3. Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    function isValidStory(data) {
      return data.keys().hasAll([
          'storyId',
          'anonymousId',
          'content',
          'seedType',
          'flowerVariant',
          'contentWarning',
          'moderationStatus',
          'warmthCount',
          'messageCount',
          'positionX',
          'positionY',
          'scale',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'storyId',
          'anonymousId',
          'content',
          'seedType',
          'flowerVariant',
          'contentWarning',
          'moderationStatus',
          'warmthCount',
          'messageCount',
          'positionX',
          'positionY',
          'scale',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.storyId) &&
        data.anonymousId is string &&
        data.anonymousId.size() >= 5 &&
        data.anonymousId.size() <= 40 &&
        data.anonymousId.matches('^Anonymous Soul #[0-9]{3,6}$') &&
        data.content is string &&
        data.content.size() >= 5 &&
        data.content.size() <= 2000 &&
        data.seedType is string &&
        data.seedType in ['daisy', 'sunflower', 'lavender'] &&
        data.flowerVariant is string &&
        data.flowerVariant in ['pink-tulip', 'yellow-tulip', 'orange-tulip', 'purple-wildflower', 'daisy', 'sunflower', 'lavender'] &&
        data.contentWarning is string &&
        data.contentWarning.size() >= 0 &&
        data.contentWarning.size() <= 120 &&
        data.moderationStatus is string &&
        data.moderationStatus in ['approved', 'flagged', 'removed'] &&
        data.warmthCount is int &&
        data.warmthCount >= 0 &&
        data.warmthCount <= 1000000 &&
        data.messageCount is int &&
        data.messageCount >= 0 &&
        data.messageCount <= 100000 &&
        (data.positionX is int || data.positionX is float) &&
        data.positionX >= 2 &&
        data.positionX <= 98 &&
        (data.positionY is int || data.positionY is float) &&
        data.positionY >= 5 &&
        data.positionY <= 88 &&
        (data.scale is int || data.scale is float) &&
        data.scale >= 0.5 &&
        data.scale <= 1.4 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReaction(data) {
      return data.keys().hasAll(['reactionId', 'storyId', 'reactionType', 'createdAt']) &&
        data.keys().hasOnly(['reactionId', 'storyId', 'reactionType', 'createdAt']) &&
        isValidId(data.reactionId) &&
        isValidId(data.storyId) &&
        data.reactionType is string &&
        data.reactionType in ['warmth', 'sunlight', 'gentle-rain'] &&
        data.createdAt is timestamp;
    }

    function isValidSupportiveMessage(data) {
      return data.keys().hasAll(['messageId', 'storyId', 'anonymousId', 'content', 'moderationStatus', 'createdAt']) &&
        data.keys().hasOnly(['messageId', 'storyId', 'anonymousId', 'content', 'moderationStatus', 'createdAt']) &&
        isValidId(data.messageId) &&
        isValidId(data.storyId) &&
        data.anonymousId is string &&
        data.anonymousId.size() >= 5 &&
        data.anonymousId.size() <= 40 &&
        data.anonymousId.matches('^Kind Gardener #[0-9]{3,6}$') &&
        data.content is string &&
        data.content.size() >= 2 &&
        data.content.size() <= 500 &&
        data.moderationStatus is string &&
        data.moderationStatus in ['approved', 'flagged', 'removed'] &&
        data.createdAt is timestamp;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reportId', 'targetType', 'targetId', 'storyId', 'reason', 'details', 'status', 'createdAt']) &&
        data.keys().hasOnly(['reportId', 'targetType', 'targetId', 'storyId', 'reason', 'details', 'status', 'createdAt']) &&
        isValidId(data.reportId) &&
        data.targetType is string &&
        data.targetType in ['story', 'message'] &&
        isValidId(data.targetId) &&
        isValidId(data.storyId) &&
        data.reason is string &&
        data.reason in ['self-harm', 'harassment', 'spam', 'pii', 'other'] &&
        data.details is string &&
        data.details.size() >= 0 &&
        data.details.size() <= 500 &&
        data.status is string &&
        data.status in ['pending', 'reviewed'] &&
        data.createdAt is timestamp;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'providerId',
          'role',
          'userAgentSummary',
          'loginCount',
          'lastLoginAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'providerId',
          'role',
          'userAgentSummary',
          'loginCount',
          'lastLoginAt',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 120 &&
        data.displayName is string &&
        data.displayName.size() >= 0 &&
        data.displayName.size() <= 100 &&
        data.photoURL is string &&
        data.photoURL.size() >= 0 &&
        data.photoURL.size() <= 500 &&
        data.providerId is string &&
        data.providerId.size() >= 1 &&
        data.providerId.size() <= 40 &&
        data.role is string &&
        data.role in ['member', 'admin'] &&
        data.userAgentSummary is string &&
        data.userAgentSummary.size() >= 0 &&
        data.userAgentSummary.size() <= 160 &&
        data.loginCount is int &&
        data.loginCount >= 1 &&
        data.loginCount <= 1000000 &&
        data.lastLoginAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLoginEvent(data) {
      return data.keys().hasAll([
          'eventId',
          'uid',
          'email',
          'displayName',
          'photoURL',
          'providerId',
          'userAgentSummary',
          'loggedInAt'
        ]) &&
        data.keys().hasOnly([
          'eventId',
          'uid',
          'email',
          'displayName',
          'photoURL',
          'providerId',
          'userAgentSummary',
          'loggedInAt'
        ]) &&
        isValidId(data.eventId) &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 120 &&
        data.displayName is string &&
        data.displayName.size() >= 0 &&
        data.displayName.size() <= 100 &&
        data.photoURL is string &&
        data.photoURL.size() >= 0 &&
        data.photoURL.size() <= 500 &&
        data.providerId is string &&
        data.providerId.size() >= 1 &&
        data.providerId.size() <= 40 &&
        data.userAgentSummary is string &&
        data.userAgentSummary.size() >= 0 &&
        data.userAgentSummary.size() <= 160 &&
        data.loggedInAt is timestamp;
    }

    function isValidSubscription(data) {
      return data.keys().hasAll([
          'subscriptionId',
          'userId',
          'userEmail',
          'userName',
          'planName',
          'billingCycle',
          'amountPaid',
          'currency',
          'status',
          'notes',
          'startedAt',
          'expiresAt',
          'recordedByUid',
          'recordedByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'subscriptionId',
          'userId',
          'userEmail',
          'userName',
          'planName',
          'billingCycle',
          'amountPaid',
          'currency',
          'status',
          'notes',
          'startedAt',
          'expiresAt',
          'recordedByUid',
          'recordedByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.subscriptionId) &&
        isValidId(data.userId) &&
        data.userEmail is string &&
        data.userEmail.size() >= 3 &&
        data.userEmail.size() <= 120 &&
        data.userName is string &&
        data.userName.size() >= 0 &&
        data.userName.size() <= 100 &&
        data.planName is string &&
        data.planName in ['free', 'seedling', 'bloom', 'sanctuary'] &&
        data.billingCycle is string &&
        data.billingCycle in ['monthly', 'yearly', 'lifetime', 'custom'] &&
        (data.amountPaid is int || data.amountPaid is float) &&
        data.amountPaid >= 0 &&
        data.amountPaid <= 100000 &&
        data.currency is string &&
        data.currency in ['INR', 'USD', 'EUR', 'GBP'] &&
        data.status is string &&
        data.status in ['active', 'trialing', 'paused', 'expired', 'cancelled'] &&
        data.notes is string &&
        data.notes.size() >= 0 &&
        data.notes.size() <= 500 &&
        data.startedAt is string &&
        data.startedAt.size() >= 0 &&
        data.startedAt.size() <= 40 &&
        data.expiresAt is string &&
        data.expiresAt.size() >= 0 &&
        data.expiresAt.size() <= 40 &&
        isValidId(data.recordedByUid) &&
        data.recordedByEmail is string &&
        data.recordedByEmail.size() >= 3 &&
        data.recordedByEmail.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSecretGardenMembership(data) {
      return data.keys().hasAll([
          'userId',
          'planId',
          'status',
          'hasUsedFreeTrial',
          'trialStartedAt',
          'trialEndsAt',
          'billingCycle',
          'priceInr',
          'startedAt',
          'nextBillingAt',
          'autoRenew',
          'paymentMode',
          'gardenTheme',
          'gardenBackground',
          'gardenEffect',
          'exclusiveFloraPreset',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'planId',
          'status',
          'hasUsedFreeTrial',
          'trialStartedAt',
          'trialEndsAt',
          'billingCycle',
          'priceInr',
          'startedAt',
          'nextBillingAt',
          'autoRenew',
          'paymentMode',
          'gardenTheme',
          'gardenBackground',
          'gardenEffect',
          'exclusiveFloraPreset',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        data.planId is string &&
        data.planId in ['free', 'secret_garden_monthly', 'secret_garden_annual'] &&
        data.status is string &&
        data.status in ['free', 'trialing', 'active', 'cancelled', 'expired'] &&
        data.hasUsedFreeTrial is bool &&
        data.trialStartedAt is string &&
        data.trialStartedAt.size() <= 40 &&
        data.trialEndsAt is string &&
        data.trialEndsAt.size() <= 40 &&
        data.billingCycle is string &&
        data.billingCycle in ['none', 'monthly', 'annual'] &&
        data.priceInr is int &&
        data.priceInr in [0, 99, 799] &&
        data.startedAt is string &&
        data.startedAt.size() <= 40 &&
        data.nextBillingAt is string &&
        data.nextBillingAt.size() <= 40 &&
        data.autoRenew is bool &&
        data.paymentMode is string &&
        data.paymentMode in ['none', 'trial_no_card', 'demo_checkout', 'admin_assigned'] &&
        data.gardenTheme is string &&
        data.gardenTheme in ['meadow', 'twilight', 'blossom_mist', 'golden_hour'] &&
        data.gardenBackground is string &&
        data.gardenBackground in ['classic_sky', 'pastel_dawn', 'starlit_dusk', 'dew_morning'] &&
        data.gardenEffect is string &&
        data.gardenEffect in ['breeze', 'fireflies', 'sakura_drift', 'sunbeams'] &&
        data.exclusiveFloraPreset is string &&
        data.exclusiveFloraPreset in ['classic', 'moonlight_iris', 'pastel_peony', 'golden_lotus'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (data.status != 'trialing' || (data.hasUsedFreeTrial == true && data.autoRenew == false && data.priceInr == 0 && data.paymentMode == 'trial_no_card')) &&
        (data.status != 'free' || (data.planId == 'free' && data.priceInr == 0 && data.autoRenew == false));
    }

    function isValidDiaryEntry(data) {
      return data.keys().hasAll([
          'entryId',
          'userId',
          'title',
          'content',
          'moodTag',
          'entryDate',
          'isMemorySaved',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'entryId',
          'userId',
          'title',
          'content',
          'moodTag',
          'entryDate',
          'isMemorySaved',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.entryId) &&
        isValidId(data.userId) &&
        data.title is string &&
        data.title.size() <= 120 &&
        data.content is string &&
        data.content.size() >= 1 &&
        data.content.size() <= 5000 &&
        data.moodTag is string &&
        data.moodTag.size() <= 40 &&
        data.entryDate is string &&
        data.entryDate.size() >= 4 &&
        data.entryDate.size() <= 40 &&
        data.isMemorySaved is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVoiceJournal(data) {
      return data.keys().hasAll([
          'voiceId',
          'userId',
          'title',
          'durationSeconds',
          'mimeType',
          'audioDataUrl',
          'recordedDate',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'voiceId',
          'userId',
          'title',
          'durationSeconds',
          'mimeType',
          'audioDataUrl',
          'recordedDate',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.voiceId) &&
        isValidId(data.userId) &&
        data.title is string &&
        data.title.size() <= 120 &&
        data.durationSeconds is int &&
        data.durationSeconds >= 1 &&
        data.durationSeconds <= 300 &&
        data.mimeType is string &&
        data.mimeType.size() >= 5 &&
        data.mimeType.size() <= 80 &&
        data.audioDataUrl is string &&
        data.audioDataUrl.size() >= 10 &&
        data.audioDataUrl.size() <= 500000 &&
        data.audioDataUrl.matches('^data:audio/.+;base64,[A-Za-z0-9+/=]+$') &&
        data.recordedDate is string &&
        data.recordedDate.size() >= 4 &&
        data.recordedDate.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSavedMemory(data) {
      return data.keys().hasAll([
          'memoryId',
          'userId',
          'sourceType',
          'sourceId',
          'anonymousLabel',
          'title',
          'excerpt',
          'flowerVariant',
          'folder',
          'personalNote',
          'savedAt'
        ]) &&
        data.keys().hasOnly([
          'memoryId',
          'userId',
          'sourceType',
          'sourceId',
          'anonymousLabel',
          'title',
          'excerpt',
          'flowerVariant',
          'folder',
          'personalNote',
          'savedAt'
        ]) &&
        isValidId(data.memoryId) &&
        isValidId(data.userId) &&
        data.sourceType is string &&
        data.sourceType in ['community_story', 'supportive_reply', 'diary_entry'] &&
        isValidId(data.sourceId) &&
        data.anonymousLabel is string &&
        data.anonymousLabel.size() >= 1 &&
        data.anonymousLabel.size() <= 60 &&
        data.title is string &&
        data.title.size() <= 140 &&
        data.excerpt is string &&
        data.excerpt.size() >= 1 &&
        data.excerpt.size() <= 2000 &&
        data.flowerVariant is string &&
        data.flowerVariant.size() <= 40 &&
        data.folder is string &&
        data.folder in ['Quiet Comfort', 'Kind Words', 'Personal Milestones', 'Unsorted'] &&
        data.personalNote is string &&
        data.personalNote.size() <= 300 &&
        data.savedAt is timestamp;
    }

    // 4. Collection Rules: Stories
    match /stories/{storyId} {
      allow get: if isValidId(storyId) && (existing().moderationStatus == 'approved' || isAdmin());
      allow list: if existing().moderationStatus == 'approved' || isAdmin();

      allow create: if isValidId(storyId) &&
        isValidStory(incoming()) &&
        incoming().storyId == storyId &&
        incoming().moderationStatus == 'approved' &&
        incoming().warmthCount >= 0 &&
        incoming().warmthCount <= 100 &&
        incoming().messageCount >= 0 &&
        incoming().messageCount <= 50 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidStory(incoming()) &&
        isValidId(storyId) &&
        (existing().moderationStatus != 'removed' || isAdmin()) &&
        incoming().storyId == existing().storyId &&
        incoming().anonymousId == existing().anonymousId &&
        incoming().content == existing().content &&
        incoming().seedType == existing().seedType &&
        incoming().flowerVariant == existing().flowerVariant &&
        incoming().contentWarning == existing().contentWarning &&
        incoming().positionX == existing().positionX &&
        incoming().positionY == existing().positionY &&
        incoming().scale == existing().scale &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (incoming().diff(existing()).affectedKeys().hasOnly(['warmthCount', 'updatedAt']) &&
            incoming().warmthCount == existing().warmthCount + 1 &&
            incoming().messageCount == existing().messageCount &&
            incoming().moderationStatus == existing().moderationStatus &&
            existsAfter(/databases/$(database)/documents/stories/$(storyId))) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'updatedAt']) &&
            incoming().messageCount == existing().messageCount + 1 &&
            incoming().warmthCount == existing().warmthCount &&
            incoming().moderationStatus == existing().moderationStatus &&
            existsAfter(/databases/$(database)/documents/stories/$(storyId))) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['moderationStatus', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(storyId);

      // Subcollection: Reactions
      match /reactions/{reactionId} {
        allow get: if isValidId(storyId) &&
          isValidId(reactionId) &&
          existing().storyId == storyId &&
          exists(/databases/$(database)/documents/stories/$(storyId)) &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.moderationStatus == 'approved';

        allow list: if existing().reactionType in ['warmth', 'sunlight', 'gentle-rain'] || isAdmin();

        allow create: if isValidId(storyId) &&
          isValidId(reactionId) &&
          isValidReaction(incoming()) &&
          incoming().reactionId == reactionId &&
          incoming().storyId == storyId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/stories/$(storyId)) &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.moderationStatus == 'approved' &&
          getAfter(/databases/$(database)/documents/stories/$(storyId)).data.warmthCount ==
            get(/databases/$(database)/documents/stories/$(storyId)).data.warmthCount + 1;

        allow update, delete: if false;
      }

      // Subcollection: Supportive Messages
      match /messages/{messageId} {
        allow get: if isValidId(storyId) &&
          isValidId(messageId) &&
          existing().storyId == storyId &&
          existing().moderationStatus == 'approved' &&
          exists(/databases/$(database)/documents/stories/$(storyId)) &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.moderationStatus == 'approved';

        allow list: if existing().moderationStatus == 'approved' || isAdmin();

        allow create: if isValidId(storyId) &&
          isValidId(messageId) &&
          isValidSupportiveMessage(incoming()) &&
          incoming().messageId == messageId &&
          incoming().storyId == storyId &&
          incoming().moderationStatus == 'approved' &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/stories/$(storyId)) &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.moderationStatus == 'approved' &&
          getAfter(/databases/$(database)/documents/stories/$(storyId)).data.messageCount ==
            get(/databases/$(database)/documents/stories/$(storyId)).data.messageCount + 1;

        allow update: if isValidSupportiveMessage(incoming()) &&
          isValidId(storyId) &&
          isValidId(messageId) &&
          isAdmin() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['moderationStatus']);

        allow delete: if isAdmin() && isValidId(storyId) && isValidId(messageId);
      }
    }

    // 5. Collection Rules: Moderation Reports
    match /reports/{reportId} {
      allow get: if isAdmin() && isValidId(reportId);
      allow list: if isAdmin() && existing().status in ['pending', 'reviewed'];

      allow create: if isValidId(reportId) &&
        isValidReport(incoming()) &&
        incoming().reportId == reportId &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/stories/$(incoming().storyId));

      allow update, delete: if false;
    }

    // 6. Collection Rules: User Accounts & Strictly Private My Space Subcollections
    match /userAccounts/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);

      allow create: if isSignedIn() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == userId &&
        incoming().role == 'member' &&
        incoming().loginCount == 1 &&
        incoming().lastLoginAt == request.time &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().loginCount == existing().loginCount + 1 &&
            incoming().lastLoginAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'email',
              'displayName',
              'photoURL',
              'providerId',
              'userAgentSummary',
              'loginCount',
              'lastLoginAt',
              'updatedAt'
            ])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(userId);

      // 6A. Strictly Private Personal Diary (Owner-Only + Backend Premium Gated)
      match /personalDiary/{entryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(entryId) &&
          isValidDiaryEntry(incoming()) &&
          incoming().entryId == entryId &&
          incoming().userId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasSecretGardenAccess(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(entryId) &&
          isValidDiaryEntry(incoming()) &&
          incoming().entryId == existing().entryId &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'content',
            'moodTag',
            'entryDate',
            'isMemorySaved',
            'updatedAt'
          ]) &&
          hasSecretGardenAccess(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(entryId);
      }

      // 6B. Strictly Private Voice Journals (Owner-Only + Backend Premium Gated)
      match /voiceJournals/{voiceId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(voiceId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(voiceId) &&
          isValidVoiceJournal(incoming()) &&
          incoming().voiceId == voiceId &&
          incoming().userId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          hasSecretGardenAccess(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(voiceId) &&
          isValidVoiceJournal(incoming()) &&
          incoming().voiceId == existing().voiceId &&
          incoming().userId == existing().userId &&
          incoming().audioDataUrl == existing().audioDataUrl &&
          incoming().mimeType == existing().mimeType &&
          incoming().durationSeconds == existing().durationSeconds &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) &&
          hasSecretGardenAccess(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(voiceId);
      }

      // 6C. Strictly Private Saved Memories (Owner-Only + Backend Premium Gated)
      match /memories/{memoryId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(memoryId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(memoryId) &&
          isValidSavedMemory(incoming()) &&
          incoming().memoryId == memoryId &&
          incoming().userId == request.auth.uid &&
          incoming().savedAt == request.time &&
          hasSecretGardenAccess(userId);

        allow update: if isOwner(userId) &&
          isValidId(userId) &&
          isValidId(memoryId) &&
          isValidSavedMemory(incoming()) &&
          incoming().memoryId == existing().memoryId &&
          incoming().userId == existing().userId &&
          incoming().sourceType == existing().sourceType &&
          incoming().sourceId == existing().sourceId &&
          incoming().anonymousLabel == existing().anonymousLabel &&
          incoming().excerpt == existing().excerpt &&
          incoming().savedAt == existing().savedAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['folder', 'personalNote', 'title']) &&
          hasSecretGardenAccess(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(memoryId);
      }
    }

    // 7. Collection Rules: Immutable Login Activity History
    match /loginEvents/{eventId} {
      allow get: if isValidId(eventId) && (isAdmin() || (isSignedIn() && existing().uid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(eventId) &&
        isValidLoginEvent(incoming()) &&
        incoming().eventId == eventId &&
        incoming().uid == request.auth.uid &&
        incoming().loggedInAt == request.time &&
        existsAfter(/databases/$(database)/documents/userAccounts/$(incoming().uid));

      allow update, delete: if false;
    }

    // 8. Collection Rules: Admin-Managed Subscription Plans
    match /subscriptions/{subscriptionId} {
      allow get: if isValidId(subscriptionId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);

      allow create: if isAdmin() &&
        isValidId(subscriptionId) &&
        isValidSubscription(incoming()) &&
        incoming().subscriptionId == subscriptionId &&
        incoming().recordedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/userAccounts/$(incoming().userId));

      allow update: if isAdmin() &&
        isValidId(subscriptionId) &&
        isValidSubscription(incoming()) &&
        (existing().status != 'cancelled' || isAdmin()) &&
        incoming().subscriptionId == existing().subscriptionId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'userEmail',
          'userName',
          'planName',
          'billingCycle',
          'amountPaid',
          'currency',
          'status',
          'notes',
          'startedAt',
          'expiresAt',
          'recordedByUid',
          'recordedByEmail',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(subscriptionId);
    }

    // 9. Collection Rules: The Secret Garden User Memberships & Customisation
    match /secretGardenMemberships/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidSecretGardenMembership(incoming()) &&
        incoming().userId == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) &&
            incoming().paymentMode in ['none', 'trial_no_card', 'demo_checkout']) ||
          isAdmin()
        );

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidSecretGardenMembership(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) &&
            (existing().hasUsedFreeTrial == false || incoming().hasUsedFreeTrial == true) &&
            !(existing().hasUsedFreeTrial == true && incoming().status == 'trialing' && existing().status != 'trialing') &&
            incoming().paymentMode in ['none', 'trial_no_card', 'demo_checkout'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'planId',
              'status',
              'hasUsedFreeTrial',
              'trialStartedAt',
              'trialEndsAt',
              'billingCycle',
              'priceInr',
              'startedAt',
              'nextBillingAt',
              'autoRenew',
              'paymentMode',
              'gardenTheme',
              'gardenBackground',
              'gardenEffect',
              'exclusiveFloraPreset',
              'updatedAt'
            ])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'planId',
              'status',
              'hasUsedFreeTrial',
              'trialStartedAt',
              'trialEndsAt',
              'billingCycle',
              'priceInr',
              'startedAt',
              'nextBillingAt',
              'autoRenew',
              'paymentMode',
              'gardenTheme',
              'gardenBackground',
              'gardenEffect',
              'exclusiveFloraPreset',
              'updatedAt'
            ]))
        );

      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(userId);
    }

    // 10. Collection Rules: Admins
    match /admins/{adminId} {
      allow get: if isAdmin() && isValidId(adminId);
      allow list, create, update, delete: if false;
    }
  }
}
